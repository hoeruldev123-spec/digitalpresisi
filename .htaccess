RewriteEngine On

# 2. Redirect 301 dari URL /site/ ke Domain Utama untuk mempertahankan SEO
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /site/(.*)\ HTTP/
RewriteRule ^(.*)$ https://digitalpresisi.com/%1 [R=301,L]

# ----------------------------------------------------------------------
# HILANGKAN EKSTENSI .PHP DARI URL
# ----------------------------------------------------------------------

# 1. Alihkan jika user sengaja mengetik .php langsung ke URL tanpa .php (SEO Friendly)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Baca file .php secara internal di server meskipun user tidak mengetik .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]